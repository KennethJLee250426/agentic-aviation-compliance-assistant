# ==========================================
# Application Server Configuration
# ==========================================
ALLOWED_ORIGINS=http://localhost:8000
AUTH_REQUIRED=true
AUTH_TOKEN=change-me-in-production
LOG_LEVEL=INFO

# Regulatory Corpus Version Tracking
CORPUS_VERSION=2026-09-24

# ==========================================
# Multi-LLM Provider API Keys (Optional per user)
# Standard LiteLLM Environment Variable Mapping
# ==========================================
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Local Ollama Host (If executing models locally)
OLLAMA_HOST=http://localhost:11434

# ==========================================
# System Default LLM Selection
# LiteLLM routing syntax (e.g. gemini/gemini-2.5-flash, 
# gpt-4o, anthropic/claude-3-5-sonnet, ollama/llama3.1:8b)
# ==========================================
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash

# ==========================================
# Fixed Vector Embedding Configuration
# (Locked to prevent vector dimension mismatches)
# ==========================================
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Vector Store Path
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./regulatory_chroma_db

# ==========================================
# Compliance RAG Retrieval Parameters
# ==========================================
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75
