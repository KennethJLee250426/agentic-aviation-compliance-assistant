# Python / Testing
__pycache__/
*.pyc
venv/
.venv/
.pytest_cache/
.coverage

# Vector DB (regenerate via ingest.py)
regulatory_chroma_db/

# Regulatory source documents — likely copyrighted/restricted, do not
# publish. Only .gitkeep placeholders are tracked.
regulations/easa/*
regulations/caas/*
regulations/caac/*
!regulations/easa/.gitkeep
!regulations/caas/.gitkeep
!regulations/caac/.gitkeep

# Environment/secrets
# Environment/secrets
.env
.env.*
*.key
*.pem

# OS / Editor / IDE cruft
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
